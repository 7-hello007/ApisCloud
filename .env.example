# ========== 运行环境 ==========
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Shanghai

# ========== 消息总线 ==========
# 可选：memory | mqtt | kafka
MESSAGE_BUS=memory

# ========== MQTT / EMQX ==========
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PORT=1883
MQTT_WS_PORT=8083
MQTT_SSL_PORT=8883
EMQX_DASHBOARD_PORT=18083

# ========== Kafka ==========
# 宿主机连：localhost:29092
# 容器内连：kafka:9092
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=apiscloud
KAFKA_PORT=29092

# ========== PostgreSQL ==========
PG_HOST=localhost
PG_PORT=5432
PG_USER=apiscloud
PG_PASSWORD=apiscloud
PG_DATABASE=apiscloud

# ========== Redis ==========
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ========== 可观测性 ==========
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_URL=http://localhost:3100
LOKI_PORT=3100

# ========== 服务端口 ==========
GATEWAY_PORT=9101
PLUGIN_HOST_PORT=9102
INGEST_PORT=9103
DATA_WRITER_PORT=9104
DISPATCH_CORE_PORT=9105
OBSERVABILITY_PORT=9106

# ========== 安全 ==========
JWT_SECRET=change-me-in-production