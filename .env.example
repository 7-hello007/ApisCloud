# ========== 运行环境 ==========
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Shanghai

# ========== 消息总线 ==========
# 可选：memory | mqtt | kafka
MESSAGE_BUS=memory

# ========== MQTT / EMQX ==========
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PORT=1883
MQTT_WS_PORT=8083
MQTT_SSL_PORT=8883
EMQX_DASHBOARD_PORT=18083

# ========== Kafka ==========
# 宿主机连：localhost:29092
# 容器内连：kafka:9092
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=apiscloud
KAFKA_PORT=29092

# ========== PostgreSQL ==========
PG_HOST=localhost
PG_PORT=5432
PG_USER=apiscloud
PG_PASSWORD=apiscloud
PG_DATABASE=apiscloud

# ========== Redis ==========
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ========== 可观测性 ==========
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_URL=http://localhost:3100
LOKI_PORT=3100

# ========== 服务端口 ==========
GATEWAY_PORT=9101
PLUGIN_HOST_PORT=9102
INGEST_PORT=9103
DATA_WRITER_PORT=9104
DISPATCH_CORE_PORT=9105
OBSERVABILITY_PORT=9106
SIMULATOR_PORT=9107

# ========== 调度核心 ==========
# 默认算法：nearest | batch-match | priority-dispatch
DISPATCH_ALGORITHM=nearest
# 算法失败/超时后的回退算法
DISPATCH_FALLBACK_ALGORITHM=nearest
# 算法超时（毫秒）
DISPATCH_ALGORITHM_TIMEOUT_MS=500
# 总线消费组
DISPATCH_CONSUMER_GROUP=apiscloud-dispatch-core

# 目标函数权重
DISPATCH_WEIGHT_DISTANCE=1.0
DISPATCH_WEIGHT_ETA=0.5
DISPATCH_WEIGHT_BATTERY=0.3
DISPATCH_WEIGHT_PRIORITY=2.0

# 指令签名密钥（生产环境必须替换）
DISPATCH_SIGN_SECRET=change-me-command-sign-secret

# 运营区域
DISPATCH_REGION_CENTER_LAT=31.2304
DISPATCH_REGION_CENTER_LNG=121.4737
DISPATCH_REGION_RADIUS_KM=30

# 硬约束参数
# 每公里耗电百分比（用于续航估算）
DISPATCH_BATTERY_PER_KM=0.5
# 平均速度（km/h，用于 ETA 估算）
DISPATCH_AVG_SPEED_KMH=40

# ========== 安全 ==========
JWT_SECRET=change-me-in-production